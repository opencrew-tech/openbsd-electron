+function isDescendantOfCurrentProcessUsingPs(pid) {
+  let current = pid;
+  while (current > 1) {
+    const result = childProcess.spawnSync('ps', ['-o', 'ppid=', '-p', String(current)], { encoding: 'utf8' });
+    const ppid = parseInt((result.stdout || '').trim(), 10);
+    if (isNaN(ppid)) return false;
+    if (ppid === process.pid) return true;
+    if (ppid === current) return false; // guard against cycles
+    current = ppid;
+  }
+  return false;
+}
