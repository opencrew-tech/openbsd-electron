+function isPathInsideRoot(rootPath: string, candidatePath: string): boolean {
+	const relativePath = path.relative(rootPath, candidatePath);
+	return relativePath !== '..' && !relativePath.startsWith(`..${path.sep}`) && !path.isAbsolute(relativePath);
+}
+
+const packageNameByRoot = new Map<string, string | null>();
+function getPackageNameForRoot(packageRoot: string): string | null {
+	if (packageNameByRoot.has(packageRoot)) {
+		return packageNameByRoot.get(packageRoot)!;
+	}
+
+	let packageName: string | null = null;
+	try {
+		const packageJsonPath = path.join(packageRoot, 'package.json');
+		const packageJson = JSON.parse(fs.readFileSync(packageJsonPath, 'utf8')) as { name?: unknown };
+		if (typeof packageJson.name === 'string' && packageJson.name) {
+			packageName = packageJson.name;
+		}
+	} catch {
+		packageName = null;
+	}
+
+	packageNameByRoot.set(packageRoot, packageName);
+	return packageName;
+}
+
+function findPackageRootForFile(filePath: string): string | null {
+	let currentPath: string;
+	try {
+		currentPath = fs.statSync(filePath).isDirectory() ? path.resolve(filePath) : path.resolve(path.dirname(filePath));
+	} catch {
+		currentPath = path.resolve(path.dirname(filePath));
+	}
+
+	while (true) {
+		const packageJsonPath = path.join(currentPath, 'package.json');
+		if (fs.existsSync(packageJsonPath)) {
+			return currentPath;
+		}
+
+		const parentPath = path.dirname(currentPath);
+		if (parentPath === currentPath) {
+			return null;
+		}
+		currentPath = parentPath;
+	}
+}
+
+function remapDependencyPathForAsar(rootPath: string, sourcePath: string): string | null {
+	const resolvedPath = path.resolve(sourcePath);
+	if (isPathInsideRoot(rootPath, resolvedPath)) {
+		return path.relative(rootPath, resolvedPath);
+	}
+
+	const marker = `${path.sep}node_modules${path.sep}`;
+	const markerIndex = resolvedPath.indexOf(marker);
+	if (markerIndex >= 0) {
+		const suffix = resolvedPath.slice(markerIndex + marker.length);
+		if (suffix) {
+			return path.join('node_modules', suffix);
+		}
+	}
+
+	const packageRoot = findPackageRootForFile(resolvedPath);
+	if (!packageRoot) {
+		return null;
+	}
+
+	const packageName = getPackageNameForRoot(packageRoot);
+	if (!packageName) {
+		return null;
+	}
+
+	const packageRelativePath = path.relative(packageRoot, resolvedPath);
+	if (packageRelativePath === '..' || packageRelativePath.startsWith(`..${path.sep}`) || path.isAbsolute(packageRelativePath)) {
+		return null;
+	}
+
+	return path.join('node_modules', packageName, packageRelativePath);
+}
+
+function remapDependencyVinylDestination(rootPath: string): NodeJS.ReadWriteStream {
+	return es.mapSync((file: { relative: string; path: string; base: string }) => {
+		if (!file.relative.startsWith('..') && !path.isAbsolute(file.relative)) {
+			return file;
+		}
+
+		const remappedRelativePath = remapDependencyPathForAsar(rootPath, file.path);
+		if (!remappedRelativePath) {
+			throw new Error(`Unable to remap dependency path: ${file.path}`);
+		}
+
+		file.base = rootPath;
+		file.path = path.join(rootPath, remappedRelativePath);
+		return file;
+	});
+}
