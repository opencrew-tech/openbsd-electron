+async function readLatestAgentHostServerLog(userDataDir: string | undefined): Promise<string | undefined> {
+	if (!userDataDir) {
+		return undefined;
+	}
+	const logsDir = resolvePath(userDataDir, 'logs');
+	try {
+		const entries = await readdir(logsDir, { withFileTypes: true });
+		const logDirs = entries
+			.filter(entry => entry.isDirectory())
+			.sort((a, b) => b.name.localeCompare(a.name));
+		for (const entry of logDirs) {
+			const logPath = resolvePath(logsDir, entry.name, 'agenthost-server.log');
+			try {
+				const content = await readFile(logPath, 'utf8');
+				return `Agent host log (${logPath}):\n${content.trimEnd()}`;
+			} catch { }
+		}
+	} catch { }
+	return `Agent host logs: ${logsDir}`;
+}
